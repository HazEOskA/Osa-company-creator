{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osatechgpt.dev/schemas/capability.schema.json",
  "title": "CapabilityContract",
  "type": "object",
  "required": ["id", "type", "provider", "authorityRequired", "expectedProof"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "authorityRequired": { "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"] },
    "expectedProof": { "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6"] },
    "estimatedCost": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": true
}
